#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "nodedr-pos: your data stays in Docker volumes (nodedr-pos_data) and your settings and generated passwords in /etc/nodedr-pos/nodedr-pos.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name nodedr-pos down -v ; sudo rm -rf /etc/nodedr-pos" >&2
fi
exit 0
