[Unit]
Description=NodeDR POS (Docker Compose)
Documentation=https://pos.nodedr.com/docs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/docker compose --project-name nodedr-pos --env-file /etc/nodedr-pos/nodedr-pos.env -f /usr/lib/nodedr-pos/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name nodedr-pos --env-file /etc/nodedr-pos/nodedr-pos.env -f /usr/lib/nodedr-pos/docker-compose.yml down

[Install]
WantedBy=multi-user.target
